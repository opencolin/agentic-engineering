---
// /pick-stack/ — Pick Your Agent Stack wizard.
// Renders the PickStack island; data is checked in at src/data/stack-questions.json.

import BaseLayout from '../layouts/BaseLayout.astro';
import PickStack from '../components/PickStack.astro';
import questions from '../data/stack-questions.json';

// Cast: the inferred TS types from the JSON are too strict (literal-narrowed
// loser_rationale shapes). The island treats this as a plain record.
const stacks = questions.stacks as unknown as Parameters<typeof PickStack>[0]['stacks'];
const qs = questions.questions as unknown as Parameters<typeof PickStack>[0]['questions'];
---

<BaseLayout
  title="Pick Your Agent Stack"
  description="Ten questions, one opinionated recommendation: inference provider, sandbox, orchestrator, observability, memory, harness. Plus why every alternative loses in your case. Share the URL to argue with the inputs, not the output."
  editSlug="src/data/stack-questions"
  editPathPrefix=""
>
  <h1>Pick Your Agent Stack</h1>
  <p class="lede">
    Ten questions. One opinionated recommendation. Why every other stack lost
    in your case. Share the URL — it round-trips your answers.
  </p>

  <PickStack questions={qs} stacks={stacks} />

  <section class="meta">
    <h2>How this works</h2>
    <p>
      Every answer carries a weight toward each named stack. We sum the weights
      and pick the highest-scoring stack, then show you a one-line rationale per
      losing alternative. The dataset is checked in at
      <code>src/data/stack-questions.json</code> — propose changes via PR.
    </p>
    <p>
      The stack names are shorthand for opinionated bundles
      (e.g. <em>Sonnet-First Production Stack</em> = Anthropic API + E2B + Inngest AgentKit + Langfuse + pgvector + Claude Code).
      The wizard does not endorse any vendor over another except where the
      weights say so for your inputs.
    </p>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--muted, #aaa);
    max-width: 50rem;
  }
  .meta {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, #2a2a2a);
    max-width: 50rem;
  }
</style>
