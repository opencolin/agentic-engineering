---
// /compare/ — interactive comparison matrix.
// Renders the CompareMatrix island; data is checked in at src/data/comparison.json.

import BaseLayout from '../layouts/BaseLayout.astro';
import CompareMatrix from '../components/CompareMatrix.astro';
import comparison from '../data/comparison.json';

const rows = comparison.rows as unknown as Parameters<typeof CompareMatrix>[0]['rows'];
---

<BaseLayout
  title="Compare — Agent Stacks Side by Side"
  description="Filterable, sortable matrix of coding agents, inference providers, sandboxes, orchestrators, observability tools, memory stores, and gateways. Filter by isolation, $/PR, HITL, MCP, license, language."
  editSlug="src/data/comparison"
  editPathPrefix=""
>
  <h1>Compare</h1>
  <p class="lede">
    {rows.length} vendors across 7 categories. Filter by isolation tier,
    dollar-per-PR, HITL support, MCP support, license, language. Every row
    carries a <code>lastVerified</code> date — rows older than 90 days are
    flagged.
  </p>

  <CompareMatrix rows={rows} />

  <section class="meta">
    <h2>The dataset</h2>
    <p>
      The matrix above is rendered from <code>src/data/comparison.json</code>
      (schema documented at the top of the file). Pricing is
      rough-order-of-magnitude — see the schema notes before citing. Click any
      column header to sort. Filters and sort are encoded in the URL hash, so
      deep links work.
    </p>
    <p>
      Add or correct a row by opening a PR against the JSON. See
      <a href="https://github.com/opencolin/agentic-engineering/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a>
      for the bar.
    </p>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--muted, #aaa);
    max-width: 60rem;
  }
  .meta {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border, #2a2a2a);
    max-width: 60rem;
  }
</style>
